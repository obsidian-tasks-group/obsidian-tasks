{
  "name": "obsidian-tasks",
  "version": "8.4.0",
  "description": "Task management for the Obsidian knowledge base",
  "main": "main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "build:dev": "node esbuild.config.mjs development",
    "lint": "eslint ./src --fix && eslint ./tests --fix && tsc --noEmit --pretty && svelte-check",
    "lint:no-fix": "eslint ./src       && eslint ./tests       && tsc --noEmit --pretty && svelte-check",
    "lint:markdown": "markdownlint-cli2 --fix \"**/*.md\" ",
    "test": "vitest run",
    "test:dev": "vitest",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "deploy:local": "node ./scripts/Test-TasksInLocalObsidian.mjs",
    "deploy:local:pwsh": "pwsh -ExecutionPolicy Unrestricted -NoProfile -File ./scripts/Test-TasksInLocalObsidian.ps1",
    "extract-i18n": "npx i18next-parser && node ./scripts/normalizeI18nLocales.mjs",
    "circular-deps-text": "node ./scripts/circular-deps-text.mjs > circular-deps.txt",
    "circular-deps-image": "madge --circular --extensions ts ./src --image circular-deps.png",
    "code-docs": "typedoc \"src/**/*\""
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "obsidian-tasks",
    "task-manager",
    "task-management"
  ],
  "author": "Clare Macrae and Ilyas Landikov (created by Martin Schenck)",
  "license": "MIT",
  "devDependencies": {
    "@approval-tests/approvals": "^7.5.8",
    "@codemirror/view": "^6.2.0",
    "@eslint/js": "^8.57.0",
    "@eslint/json": "0.14.0",
    "@evilmartians/lefthook": "^1.7.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/mustache": "^4.2.5",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "async-mutex": "^0.5.0",
    "esbuild": "0.28.1",
    "esbuild-sass-plugin": "^3.2.0",
    "esbuild-svelte": "^0.9.5",
    "eslint": "9.26.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^13.0.0",
    "i18next-parser": "^9.1.0",
    "jest-sorted": "^1.0.15",
    "jsdom": "^30.0.1",
    "madge": "^8.0.0",
    "markdownlint-cli2": "^0.22.1",
    "moment": "^2.31.0",
    "obsidian": "1.13.1",
    "obsidian-typings": "^2.11.1",
    "prettier": "^3.9.8",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.8.1",
    "tslib": "^2.8.1",
    "typedoc": "^0.27.9",
    "typedoc-plugin-mdn-links": "^4.0.4",
    "typedoc-umlclass": "^0.10.1",
    "typescript": "^5.0.4",
    "typescript-eslint": "^8.59.1",
    "vite": "^8.2.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.6",
    "boon-js": "^2.0.5",
    "chrono-node": "2.3.9",
    "eventemitter2": "^6.4.5",
    "flatpickr": "^4.6.13",
    "i18next": "^24.2.1",
    "mustache": "^4.2.0",
    "mustache-validator": "^0.2.0",
    "rrule": "^2.8.1",
    "safe-regex2": "^5.1.1"
  }
}
